<header id="site-header" class="header">
    <div class="logo">
        <a href="/">Adèle B.</a>
    </div>

    <nav>
        <a href="#oeuvres">Œuvres</a>
        <a href="#demarche">Démarche</a>
        <a href="#expositions">Expositions</a>
        <a href="#galerie">Galerie</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<style>
.header{

    position:fixed;
    top:0;
    left:0;
    right:0;

    z-index:1000;

    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;

    padding:1.25rem 8%;

    background:rgba(250,248,245,.92);

    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);

    border-bottom:1px solid rgba(0,0,0,.06);

    transition:
        transform .35s ease,
        background .3s ease;

}

.header.hidden{

    transform:translateY(-100%);

}

.logo a{
    justify-self:start;
    font-size:2.6rem;
    font-family:"Bellefair", serif;
    font-weight:400;
    letter-spacing:.02em;
    color:#222;
    text-decoration:none;
}


nav{
    justify-self:center;
    display:flex;
    gap:1.5rem;
}

nav a{
    font-size:1.05rem;
    letter-spacing:.03em;
    text-decoration:none;
    color:#444;
    transition:.2s;
}

nav a:hover{
    color:#000;
}

@media (max-width:900px){

    .header{

        grid-template-columns:1fr;

        justify-items:center;

        padding:1rem 1.5rem;

        gap:.75rem;

    }

    .logo{

        justify-self:center;

    }

    .logo a{

        font-size:2rem;

    }

    nav{

        justify-self:center;

        justify-content:center;

        flex-wrap:wrap;

        gap:.6rem 1.2rem;

    }

    nav a{

        font-size:.95rem;

    }

}
</style>

<script>

let lastScroll = 0;

const header = document.getElementById("site-header");

window.addEventListener("scroll", () => {

    const current = window.scrollY;

    if(current < 40){

        header?.classList.remove("hidden");

        lastScroll = current;

        return;

    }

    if(current > lastScroll){

        header?.classList.add("hidden");

    }else{

        header?.classList.remove("hidden");

    }

    lastScroll = current;

});

</script>